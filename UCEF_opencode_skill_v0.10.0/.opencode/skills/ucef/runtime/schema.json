{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UCEF v0.10.0 Legacy Import Result",
  "type": "object",
  "properties": {
    "scenario": {"$ref": "#/$defs/Scenario"},
    "evidences": {"type": "array", "items": {"$ref": "#/$defs/Evidence"}},
    "fragments": {"type": "array", "items": {"$ref": "#/$defs/Fragment"}},
    "method_definitions": {"type": "array", "items": {"$ref": "#/$defs/MethodDefinition"}},
    "trace_stages": {"type": "array", "items": {"$ref": "#/$defs/TraceStage"}},
    "implementation_slices": {"type": "array", "items": {"$ref": "#/$defs/ImplementationSlice"}},
    "coverage_gates": {"type": "array", "items": {"$ref": "#/$defs/CoverageGate"}},
    "execution_nodes": {"type": "array", "items": {"$ref": "#/$defs/ExecutionNode"}},
    "field_inventory": {"type": "array", "items": {"$ref": "#/$defs/FieldInventoryItem"}},
    "route_decisions": {"type": "array", "items": {"$ref": "#/$defs/RouteDecision"}},
    "field_lineage_steps": {"type": "array", "items": {"$ref": "#/$defs/FieldLineageStep"}},
    "persistence_effects": {"type": "array", "items": {"$ref": "#/$defs/PersistenceEffect"}},
    "external_interactions": {"type": "array", "items": {"$ref": "#/$defs/ExternalInteraction"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/Gap"}},
    "next_work_units": {"type": "array", "items": {"$ref": "#/$defs/WorkUnit"}}
  },
  "additionalProperties": false,
  "$defs": {
    "Status": {"enum": ["DISCOVERED", "CANDIDATE", "STATIC_VERIFIED", "SCENARIO_CONFIRMED", "REJECTED", "UNKNOWN", "STALE"]},
    "EvidenceIds": {"type": "array", "items": {"type": "string", "pattern": "^EV-"}, "minItems": 1},
    "ObservationIds": {"type": "array", "items": {"type": "string", "pattern": "^OBS-"}},
    "Scenario": {
      "type": "object",
      "required": ["scenario_id", "name", "business_operation", "business_goal", "trigger", "scope", "expected_outcome"],
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^SCN-"},
        "name": {"type": "string"},
        "business_operation": {"type": "string"},
        "business_goal": {"type": "string"},
        "trigger": {"type": "object"},
        "scope": {
          "type": "object",
          "required": ["source_ids"],
          "properties": {
            "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "source_revisions": {"type": "object", "additionalProperties": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "expected_outcome": {"type": "string"},
        "critical_fields": {"type": "array", "items": {"type": "string"}},
        "observation_ids": {"$ref": "#/$defs/ObservationIds"},
        "status": {"type": "string"}
      },
      "additionalProperties": true
    },
    "Evidence": {
      "type": "object",
      "required": ["evidence_kind", "source", "observation"],
      "properties": {
        "evidence_id": {"type": "string"},
        "scenario_id": {"type": "string"},
        "evidence_kind": {"enum": ["SOURCE", "CONFIG", "BUILD", "TEST", "RUNTIME", "DATABASE_METADATA", "EXTERNAL_CONTRACT"]},
        "source": {"oneOf": [{"type": "string"}, {"type": "object"}]},
        "observation": {"type": "string"},
        "artifact_id": {"type": "string", "pattern": "^ART-"},
        "locator": {
          "type": "object",
          "properties": {
            "selector_type": {"enum": ["JSON_POINTER", "LINE_RANGE", "KEY", "QUERY"]},
            "selector": {"type": "string"},
            "excerpt_hash": {"type": "string"}
          },
          "additionalProperties": true
        },
        "observation_ids": {"$ref": "#/$defs/ObservationIds"}
      },
      "additionalProperties": true
    },
    "Fragment": {
      "type": "object",
      "required": ["logical_key", "source_id", "name", "business_purpose", "entry_contract", "exit_contract", "status", "evidence_ids"],
      "properties": {
        "fragment_id": {"type": "string"},
        "logical_key": {"type": "string"},
        "source_id": {"type": "string"},
        "name": {"type": "string"},
        "business_purpose": {"type": "string"},
        "repository": {"type": "string"},
        "code_revision": {"type": "string"},
        "code_hash": {"type": "string"},
        "binding_hash": {"type": "string"},
        "applicability": {"type": "object"},
        "coverage": {"type": "object"},
        "entry_contract": {"type": "object"},
        "exit_contract": {"type": "object"},
        "preconditions": {"type": "array"},
        "postconditions": {"type": "array"},
        "side_effects": {"type": "array"},
        "handoffs": {"type": "array"},
        "contract_complete": {"type": "boolean"},
        "status": {"$ref": "#/$defs/Status"},
        "observation_ids": {"$ref": "#/$defs/ObservationIds"},
        "evidence_ids": {"$ref": "#/$defs/EvidenceIds"}
      },
      "additionalProperties": true
    },
    "MethodDefinition": {
      "type": "object",
      "required": ["source_id", "symbol", "module", "class_name", "method_name", "signature", "file", "code_hash", "input_contract", "output_contract", "status", "evidence_ids"],
      "properties": {
        "method_definition_id": {"type": "string"},
        "source_id": {"type": "string"},
        "symbol": {"type": "string"},
        "module": {"type": "string"},
        "class_name": {"type": "string"},
        "method_name": {"type": "string"},
        "signature": {"type": "string"},
        "file": {"type": "string"},
        "line_start": {"type": "integer"},
        "line_end": {"type": "integer"},
        "code_hash": {"type": "string"},
        "input_contract": {"type": "object"},
        "output_contract": {"type": "object"},
        "throws": {"type": "array"},
        "status": {"$ref": "#/$defs/Status"},
        "observation_ids": {"$ref": "#/$defs/ObservationIds"},
        "evidence_ids": {"$ref": "#/$defs/EvidenceIds"}
      },
      "additionalProperties": true
    },
    "TraceStage": {
      "type": "object",
      "required": ["scenario_id", "source_id", "sequence_no", "name", "business_purpose", "input", "processing", "output", "status"],
      "properties": {
        "stage_id": {"type": "string"},
        "scenario_id": {"type": "string"},
        "source_id": {"type": "string"},
        "stage_key": {"type": "string"},
        "sequence_no": {"type": "number"},
        "stage_type": {"enum": ["ENTRY", "NORMALIZE", "LOAD_CONTEXT", "ROUTE", "PROCESS", "EXTERNAL", "PERSIST", "ASYNC", "TERMINAL"]},
        "fragment_id": {"type": "string"},
        "name": {"type": "string"},
        "business_purpose": {"type": "string"},
        "why_current": {"type": "string"},
        "input": {},
        "processing": {},
        "output": {},
        "state_changes": {"type": "array"},
        "next_handoff": {},
        "terminal": {"type": "boolean"},
        "terminal_outcome": {},
        "status": {"$ref": "#/$defs/Status"},
        "observation_ids": {"$ref": "#/$defs/ObservationIds"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "ImplementationSlice": {
      "type": "object",
      "required": ["scenario_id", "stage_id", "source_id", "sequence_no", "name", "business_purpose", "focus_mode", "method_path", "internal_steps", "technical_bridges", "semantic_closure", "closure_status", "status", "evidence_ids"],
      "properties": {
        "slice_id": {"type": "string", "pattern": "^SLICE-"},
        "scenario_id": {"type": "string"},
        "stage_id": {"type": "string"},
        "source_id": {"type": "string"},
        "sequence_no": {"type": "number"},
        "name": {"type": "string"},
        "business_purpose": {"type": "string"},
        "focus_mode": {"enum": ["GENERAL", "ROUTE", "FIELD", "BOUNDARY", "ERROR"]},
        "method_path": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "execution_node_ids": {"type": "array", "items": {"type": "string"}},
        "internal_steps": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "route_and_config": {"type": "array"},
        "field_effects": {"type": "array"},
        "boundaries": {"type": "array"},
        "error_and_timing": {"type": "array"},
        "technical_bridges": {"type": "array", "items": {"$ref": "#/$defs/TechnicalBridge"}},
        "semantic_closure": {"$ref": "#/$defs/SemanticClosure"},
        "closure_status": {"enum": ["OPEN", "COMPLETE", "GAP"]},
        "gap_ids": {"type": "array", "items": {"type": "string"}},
        "status": {"$ref": "#/$defs/Status"},
        "observation_ids": {"$ref": "#/$defs/ObservationIds"},
        "evidence_ids": {"$ref": "#/$defs/EvidenceIds"}
      },
      "additionalProperties": true
    },
    "TechnicalBridge": {
      "type": "object",
      "required": ["from", "to", "reason"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "reason": {"type": "string"},
        "framework": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "SemanticClosure": {
      "type": "object",
      "required": ["input_understood", "decisions_understood", "fields_understood", "side_effects_understood", "output_understood", "unknowns_as_gaps"],
      "properties": {
        "input_understood": {"type": "boolean"},
        "decisions_understood": {"type": "boolean"},
        "fields_understood": {"type": "boolean"},
        "side_effects_understood": {"type": "boolean"},
        "output_understood": {"type": "boolean"},
        "unknowns_as_gaps": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "CoverageGate": {
      "type": "object",
      "required": ["scenario_id", "gate_type", "priority", "question", "status"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^GATE-"},
        "scenario_id": {"type": "string"},
        "stage_id": {"type": "string"},
        "gate_type": {"enum": ["SPINE", "ROUTE", "P0_FIELD", "PERSISTENCE", "EXTERNAL", "OUTCOME", "ERROR"]},
        "priority": {"enum": ["G0", "G1", "G2", "G3", "G4"]},
        "question": {"type": "string"},
        "status": {"enum": ["OPEN", "CLOSED", "GAP_ACCEPTED", "DEFERRED"]},
        "field": {"type": "string"},
        "gap_ids": {"type": "array", "items": {"type": "string"}},
        "observation_ids": {"$ref": "#/$defs/ObservationIds"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "ExecutionNode": {
      "type": "object",
      "required": ["scenario_id", "source_id", "node_type", "sequence_no", "name", "business_purpose", "status"],
      "properties": {
        "execution_node_id": {"type": "string"},
        "scenario_id": {"type": "string"},
        "source_id": {"type": "string"},
        "parent_node_id": {"type": "string"},
        "stage_id": {"type": "string"},
        "method_definition_id": {"type": "string"},
        "reference_node_id": {"type": "string"},
        "node_type": {"enum": ["MODULE", "METHOD_INVOCATION", "STEP", "BRANCH", "LOOP", "ASYNC_HANDOFF", "REFERENCE", "RECURSION"]},
        "sequence_no": {"type": "number"},
        "module": {"type": "string"},
        "name": {"type": "string"},
        "business_purpose": {"type": "string"},
        "step_kind": {"enum": ["VALIDATE", "READ", "DEFAULT", "ASSIGN", "TRANSFORM", "COMPUTE", "ROUTE", "CALL", "PERSIST", "EXTERNAL", "RETURN", "ERROR"]},
        "condition": {},
        "selected": {"type": "boolean"},
        "input": {},
        "processing": {},
        "output": {},
        "field_reads": {"type": "array", "items": {"type": "string"}},
        "field_writes": {"type": "array", "items": {"type": "string"}},
        "status": {"$ref": "#/$defs/Status"},
        "observation_ids": {"$ref": "#/$defs/ObservationIds"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "FieldInventoryItem": {
      "type": "object",
      "required": ["scenario_id", "canonical_field", "priority", "tracking_status", "business_use", "evidence_ids"],
      "properties": {
        "field_id": {"type": "string"},
        "scenario_id": {"type": "string"},
        "canonical_field": {"type": "string"},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "tracking_status": {"enum": ["TRACKED", "EXCLUDED", "GAP"]},
        "entry_locations": {"type": "array"},
        "expected_sinks": {"type": "array"},
        "business_use": {"type": "string"},
        "exclusion_reason": {"type": "string"},
        "status": {"$ref": "#/$defs/Status"},
        "observation_ids": {"$ref": "#/$defs/ObservationIds"},
        "evidence_ids": {"$ref": "#/$defs/EvidenceIds"}
      },
      "additionalProperties": true
    },
    "RouteDecision": {
      "type": "object",
      "required": ["scenario_id", "source_id", "question", "inputs", "current_outcome", "reason", "evidence_ids"],
      "properties": {
        "decision_id": {"type": "string"},
        "scenario_id": {"type": "string"},
        "source_id": {"type": "string"},
        "stage_id": {"type": "string"},
        "execution_node_id": {"type": "string"},
        "question": {"type": "string"},
        "inputs": {"type": "array"},
        "alternatives": {"type": "array"},
        "current_outcome": {},
        "reason": {"type": "string"},
        "status": {"$ref": "#/$defs/Status"},
        "observation_ids": {"$ref": "#/$defs/ObservationIds"},
        "evidence_ids": {"$ref": "#/$defs/EvidenceIds"}
      },
      "additionalProperties": true
    },
    "FieldLineageStep": {
      "type": "object",
      "required": ["scenario_id", "source_id", "execution_node_id", "canonical_field", "sequence_no", "lineage_role", "operation", "source", "target", "business_use", "evidence_ids"],
      "properties": {
        "lineage_step_id": {"type": "string"},
        "scenario_id": {"type": "string"},
        "source_id": {"type": "string"},
        "stage_id": {"type": "string"},
        "execution_node_id": {"type": "string"},
        "canonical_field": {"type": "string"},
        "sequence_no": {"type": "number"},
        "lineage_role": {"enum": ["ORIGIN", "TRANSFORM", "SINK"]},
        "java_location": {"type": "string"},
        "source": {},
        "target": {},
        "operation": {"enum": ["READ", "VALIDATE", "COPY", "RENAME", "DEFAULT", "OVERRIDE", "COMPUTE", "CONVERT", "MERGE", "SPLIT", "DROP", "MASK", "PERSIST", "EXTERNAL_REQUEST", "RESPONSE_MAPPING", "RETURN"]},
        "previous_step_ids": {"type": "array", "items": {"type": "string"}},
        "expression": {"type": "string"},
        "value_before": {},
        "value_after": {},
        "data_type_before": {"type": "string"},
        "data_type_after": {"type": "string"},
        "null_behavior": {"type": "string"},
        "transformation": {"type": "string"},
        "condition": {},
        "business_use": {"type": "string"},
        "status": {"$ref": "#/$defs/Status"},
        "observation_ids": {"$ref": "#/$defs/ObservationIds"},
        "evidence_ids": {"$ref": "#/$defs/EvidenceIds"}
      },
      "additionalProperties": true
    },
    "Mapping": {
      "type": "object",
      "required": ["target", "value_source", "business_use"],
      "properties": {
        "canonical_field": {"type": "string"},
        "target": {"type": "string"},
        "value_source": {"type": "string"},
        "transformation": {"type": "string"},
        "business_use": {"type": "string"}
      },
      "additionalProperties": true
    },
    "PersistenceEffect": {
      "type": "object",
      "required": ["scenario_id", "source_id", "store", "operation", "mappings", "business_effect", "evidence_ids"],
      "properties": {
        "effect_id": {"type": "string"},
        "scenario_id": {"type": "string"},
        "source_id": {"type": "string"},
        "stage_id": {"type": "string"},
        "execution_node_id": {"type": "string"},
        "store": {"type": "string"},
        "operation": {"enum": ["SELECT", "INSERT", "UPDATE", "UPSERT", "DELETE", "PUBLISH", "CACHE_READ", "CACHE_WRITE"]},
        "condition": {},
        "transaction_context": {},
        "key_fields": {"type": "array"},
        "mappings": {"type": "array", "items": {"$ref": "#/$defs/Mapping"}},
        "business_effect": {"type": "string"},
        "status": {"$ref": "#/$defs/Status"},
        "observation_ids": {"$ref": "#/$defs/ObservationIds"},
        "evidence_ids": {"$ref": "#/$defs/EvidenceIds"}
      },
      "additionalProperties": true
    },
    "RequestParameter": {
      "type": "object",
      "required": ["external_name", "internal_origin", "business_use"],
      "properties": {
        "canonical_field": {"type": "string"},
        "external_name": {"type": "string"},
        "internal_origin": {"type": "string"},
        "transformation": {"type": "string"},
        "business_use": {"type": "string"}
      },
      "additionalProperties": true
    },
    "ResponseParameter": {
      "type": "object",
      "required": ["external_name"],
      "properties": {
        "canonical_field": {"type": "string"},
        "external_name": {"type": "string"},
        "consumed": {"type": "boolean"},
        "internal_target": {"type": "string"},
        "transformation": {"type": "string"},
        "business_use": {"type": "string"}
      },
      "additionalProperties": true
    },
    "ExternalInteraction": {
      "type": "object",
      "required": ["scenario_id", "source_id", "target_system", "operation", "business_purpose", "request_params", "response_params", "evidence_ids"],
      "properties": {
        "interaction_id": {"type": "string"},
        "scenario_id": {"type": "string"},
        "source_id": {"type": "string"},
        "stage_id": {"type": "string"},
        "execution_node_id": {"type": "string"},
        "target_system": {"type": "string"},
        "operation": {"type": "string"},
        "protocol": {"type": "string"},
        "call_mode": {"type": "string"},
        "trigger_condition": {},
        "business_purpose": {"type": "string"},
        "request_params": {"type": "array", "items": {"$ref": "#/$defs/RequestParameter"}},
        "response_params": {"type": "array", "items": {"$ref": "#/$defs/ResponseParameter"}},
        "error_behavior": {},
        "status": {"$ref": "#/$defs/Status"},
        "observation_ids": {"$ref": "#/$defs/ObservationIds"},
        "evidence_ids": {"$ref": "#/$defs/EvidenceIds"}
      },
      "additionalProperties": true
    },
    "Gap": {
      "type": "object",
      "required": ["scenario_id", "category", "severity", "question"],
      "properties": {
        "gap_id": {"type": "string"},
        "scenario_id": {"type": "string"},
        "stage_id": {"type": "string"},
        "execution_node_id": {"type": "string"},
        "category": {"type": "string"},
        "severity": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "question": {"type": "string"},
        "missing_evidence": {"type": "array"},
        "suggested_work_type": {"type": "string"},
        "observation_ids": {"$ref": "#/$defs/ObservationIds"}
      },
      "additionalProperties": true
    },
    "WorkUnit": {
      "type": "object",
      "required": ["scenario_id", "work_type", "objective"],
      "properties": {
        "work_unit_id": {"type": "string"},
        "scenario_id": {"type": "string"},
        "work_type": {"type": "string"},
        "protocol_version": {"type": "string"},
        "role": {"enum": ["SKELETON", "SLICE", "INTEGRATION", "REPAIR"]},
        "objective": {"type": "string"},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "closes_gate_ids": {"type": "array", "items": {"type": "string"}},
        "acceptance_tests": {"type": "array", "items": {"type": "string"}},
        "non_goals": {"type": "array", "items": {"type": "string"}},
        "allowed_operations": {"type": "array", "items": {"type": "string"}},
        "budgets": {"type": "object"}
      },
      "additionalProperties": true
    }
  }
}
